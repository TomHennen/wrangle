@test "go.checks: validate_inputs.sh accepts a project with go.mod" {
    local proj="$BATS_TEST_TMPDIR/proj"
    write_gomod "$proj"
    cd "$BATS_TEST_TMPDIR"
    run "$CHECKS_DIR/validate_inputs.sh" "proj" "enabled" "fail"
    [[ "$status" -eq 0 ]]
}

@test "go.checks: validate_inputs.sh DOES NOT require .goreleaser.yml (checks runs without it)" {
    # Quality gates are useful even on projects that haven't wired
    # goreleaser yet. Only build/ enforces .goreleaser.yml.
    local proj="$BATS_TEST_TMPDIR/proj"
    write_gomod "$proj"
    cd "$BATS_TEST_TMPDIR"
    run "$CHECKS_DIR/validate_inputs.sh" "proj" "enabled" "fail"
    [[ "$status" -eq 0 ]]
}

@test "go.checks: validate_inputs.sh rejects missing go.mod" {
    local proj="$BATS_TEST_TMPDIR/proj"
    mkdir -p "$proj"
    cd "$BATS_TEST_TMPDIR"
    run "$CHECKS_DIR/validate_inputs.sh" "proj" "enabled" "fail"
    [[ "$status" -ne 0 ]]
    [[ "$output" == *"no go.mod found"* ]]
}

@test "go.build: validate_inputs.sh accepts a project with go.mod AND .goreleaser.yml" {
